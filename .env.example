# Copy to .env for local dev:  cp .env.example .env
# For GitHub Pages, add VITE_WEB3FORMS_ACCESS_KEY under:
#   Repo → Settings → Secrets and variables → Actions

# Web3Forms access key — https://web3forms.com (sign up with rulete.jeric@gmail.com)
VITE_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# Optional: only set if you use a custom hCaptcha key on a Web3Forms PAID plan.
# Free plan must use Web3Forms' built-in key (already configured in contact-section.tsx).
# VITE_HCAPTCHA_SITE_KEY=
